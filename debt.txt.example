# Local secrets template. Copy to debt.txt (gitignored) and fill values.
# The API reads repo-root debt.txt and backend/.env. Never commit either.

APP_ENV=development
APP_SECRET_KEY=

# PostgreSQL on this machine. The API is the only client. Never a remote host.
# Local docker: postgresql://stephan:stephan@127.0.0.1:5432/stephan
# On Lightsail the password is generated on the server and written only here.
DATABASE_URL=
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200
# Invitation links use this, including when the API is running on your machine.
PUBLIC_APP_URL=https://stephan.net.br

AUTHOR_EMAIL=
AUTHOR_NAME=Stephan

LLM_PROVIDER=placeholder
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o

RESEARCH_DIGEST_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
CONSULTING_NOTIFY_TO=

GITHUB_REPO=HenriqueFStephan/Stephan
GITHUB_STUDIO_TOKEN=
STUDIO_ACCESS_TOKEN=
STUDIO_ATTACHMENTS_BRANCH=studio-attachments
# When set, the public site shows a maintenance page until this password is entered.
BLOCKWALL_KEY=
